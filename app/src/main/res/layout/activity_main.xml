<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- 1. Live Camera Preview Surface -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Top Header HUD (Status & Battery Temp, NO IP/Bitrate/FPS) -->
    <RelativeLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingTop="52dp"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <!-- Connection Status Pill (Left) -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_overlay_dot_core" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОЖИДАНИЕ ПК"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Battery Temperature Chip (Right) -->
        <LinearLayout
            android:id="@+id/batteryTempPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_temp_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/batteryTempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32°C"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2b. Auto-Update Notification Banner -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="105dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_update_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnDismissUpdate"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUpdateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Доступно обновление"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUpdateDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Нажмите для загрузки и установки"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDismissUpdate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#71717A" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/updateProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FBBF24"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Bottom Glassmorphic Control Bar -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_bar"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <!-- Flip Camera Button -->
        <ImageView
            android:id="@+id/btnFlipCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_action"
            android:padding="10dp"
            android:src="@drawable/ic_switch_camera"
            android:contentDescription="Flip Camera"
            app:tint="#FFFFFF" />

        <!-- Floating Mode (Telegram/WhatsApp overlay) Button -->
        <ImageView
            android:id="@+id/btnFloatingMode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_action"
            android:padding="10dp"
            android:src="@drawable/ic_floating_window"
            android:contentDescription="Floating Mode"
            app:tint="#38BDF8" />

        <!-- Eco Blackout Button -->
        <ImageView
            android:id="@+id/btnEcoBlackout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_action"
            android:padding="10dp"
            android:src="@drawable/ic_eco"
            android:contentDescription="Eco Blackout"
            app:tint="#10B981" />

        <!-- Microphone Mute Toggle Button -->
        <ImageView
            android:id="@+id/btnMuteMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_action"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Mute Microphone"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 4. OLED Fullscreen Blackout Overlay (Double tap to wake) -->
    <View
        android:id="@+id/blackoutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
