<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- 1. Live Camera Preview Surface -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Top Header HUD (Status & Battery Temp, NO IP/Bitrate/FPS) -->
    <RelativeLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingTop="52dp"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <!-- Connection Status Pill (Left) -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_overlay_dot_core" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОЖИДАНИЕ ПК"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Battery Temperature Chip (Right) -->
        <LinearLayout
            android:id="@+id/batteryTempPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_temp_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/batteryTempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32°C"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2b. Auto-Update Notification Banner -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="105dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_update_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnDismissUpdate"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUpdateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Доступно обновление"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUpdateDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Нажмите для загрузки и установки"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDismissUpdate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#71717A" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/updateProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FBBF24"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2c. Floating Mode Toggle Pill (Clear visual status & description) -->
    <LinearLayout
        android:id="@+id/btnFloatingTogglePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="92dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivFloatingPillIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_floating_window"
            app:tint="#38BDF8" />

        <TextView
            android:id="@+id/tvFloatingPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Поверх приложений: ВКЛ"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/dotFloatingPill"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_dot_core"
            android:backgroundTint="#10B981" />
    </LinearLayout>

    <!-- 3. Bottom Glassmorphic Control Panel (with collapse/expand) -->
    <LinearLayout
        android:id="@+id/bottomPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Кнопка скрытия панели (Свернуть панель управления) -->
        <LinearLayout
            android:id="@+id/btnHideBottomPanel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bottom_bar"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#D4D4D8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Скрыть панель"
                android:textColor="#D4D4D8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2d. Dynamic Lens Selection Bar (0.5x, 1x, 2x, 3x, 5x, 10x etc.) -->
        <LinearLayout
            android:id="@+id/lensBarLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_bar"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp" />

        <!-- 3. Bottom Glassmorphic Control Bar -->
        <LinearLayout
            android:id="@+id/bottomActionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_bar"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- Flip Camera Button -->
            <ImageView
                android:id="@+id/btnFlipCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:src="@drawable/ic_switch_camera"
                android:contentDescription="Flip Camera"
                app:tint="#FFFFFF" />

            <!-- Auto-Framing Toggle Button -->
            <ImageView
                android:id="@+id/btnAutoFraming"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:src="@drawable/ic_face_tracking"
                android:contentDescription="Auto-Framing"
                app:tint="#A1A1AA" />

            <!-- Stabilization (OIS / EIS) Toggle Button -->
            <ImageView
                android:id="@+id/btnStabilization"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:src="@drawable/ic_stabilization"
                android:contentDescription="Stabilization"
                app:tint="#A1A1AA" />

            <!-- Floating Mode (Telegram/WhatsApp overlay) Button -->
            <ImageView
                android:id="@+id/btnFloatingMode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:src="@drawable/ic_floating_window"
                android:contentDescription="Floating Mode"
                app:tint="#38BDF8" />

            <!-- Eco Blackout Button -->
            <ImageView
                android:id="@+id/btnEcoBlackout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:src="@drawable/ic_eco"
                android:contentDescription="Eco Blackout"
                app:tint="#10B981" />

            <!-- Microphone Mute Toggle Button -->
            <ImageView
                android:id="@+id/btnMuteMic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                android:contentDescription="Mute Microphone"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопка выезда панели снизу (Развернуть панель управления) -->
    <LinearLayout
        android:id="@+id/btnShowBottomPanel"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_up"
            app:tint="#38BDF8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Панель управления"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. OLED Fullscreen Blackout Overlay (Double tap to wake) -->
    <View
        android:id="@+id/blackoutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
